# --- Telegram ---
BOT_TOKEN=
# Comma-separated Telegram IDs of admins (required in production)
ADMIN_IDS=
# Private channel for lesson photos (-100...). Can also be set later with /setchannel.
PHOTO_CHANNEL_ID=
# Public HTTPS URL of this service (Mini App + webhook)
WEBAPP_URL=http://localhost:5173
PUBLIC_URL=
# 32+ random chars [A-Za-z0-9_-]: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Database ---
DB_PATH=./data/school.db
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=14
# Optional: chat ID that receives the monthly backup on the 1st (Excel + .db.gz), e.g. your admin ID
BACKUP_TELEGRAM_CHAT_ID=

# --- Google Sheets (optional: one-time import + read-only mirror) ---
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_CREDENTIALS_JSON=
# 1 = overwrite the spreadsheet with DB contents every N minutes. Use a NEW spreadsheet.
SHEETS_MIRROR=0
SHEETS_MIRROR_EVERY_MIN=15

PORT=3000
NODE_ENV=development
